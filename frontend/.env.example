# API Configuration
VITE_API_URL=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev
# Dev-server proxy target (backend API base URL); used by vite.config.ts for `npm run dev`
VITE_DEV_PROXY_TARGET=https://your-api-id.execute-api.us-east-1.amazonaws.com/dev

# AWS Cognito Configuration
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
